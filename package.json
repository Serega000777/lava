{
  "name": "lava",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/web", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @lava/web",
    "build": "npm run build --workspace @lava/web",
    "lint": "npm run lint --workspace @lava/web",
