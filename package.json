{
  "name": "lava",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/web", "apps/mobile", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @lava/web",
    "build": "npm run build --workspace @lava/web",
    "lint": "npm run lint --workspace @lava/web",
    "typecheck": "npm run typecheck --workspace @lava/web",
    "test": "npm run test --workspace @lava/web",
    "mobile": "npm run start --workspace @lava/mobile",
    "check:mobile": "npm run check --workspace @lava/mobile",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:mobile"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "expo": "~57.0.15",
    "react": "19.2.3",
    "react-native": "0.86.2"
  }
}
