APP_ENV=development
POSTGRES_DB=lava
POSTGRES_USER=lava
POSTGRES_PASSWORD=lava_local
DATABASE_URL=postgresql+asyncpg://lava:lava_local@postgres:5432/lava
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=lava
S3_SECRET_KEY=lava_local_secret
S3_BUCKET=media
NEXT_PUBLIC_API_URL=http://localhost:8000
SESSION_TTL_HOURS=720
PASSWORD_LOGIN_ENABLED=true
LOCAL_OTP_ENABLED=true
SMS_OTP_ENABLED=false
VK_OAUTH_ENABLED=false
ALLOWED_ORIGINS=http://localhost:3000
AUTH_ACCOUNT_FAILURE_WINDOW_SECONDS=3600
AUTH_ACCOUNT_DELAY_AFTER=3
AUTH_ACCOUNT_DELAY_BASE_SECONDS=2
AUTH_ACCOUNT_DELAY_MAX_SECONDS=300
RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-random-characters
OTP_MAX_ATTEMPTS=5
COMPLAINT_RATE_LIMIT=10
COMPLAINT_TARGET_RATE_LIMIT=3
COMPLAINT_RATE_WINDOW_SECONDS=86400
MESSAGE_RATE_LIMIT=60
MESSAGE_CONVERSATION_RATE_LIMIT=20
MESSAGE_RATE_WINDOW_SECONDS=60
# Required to enable the otherwise hidden /internal/metrics endpoint.
METRICS_TOKEN=
